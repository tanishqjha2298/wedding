# ─────────────────────────────────────────────────────────────────────────────
# Wedding site configuration
#
# 1. Copy this file to `.env.local`  (that file is git-ignored, never committed)
# 2. Fill in the values from YOUR Firebase project
# 3. For the live site, add these same vars in Vercel → Project → Settings →
#    Environment Variables
#
# These Firebase values are NOT secret — they are meant to ship in the browser.
# Your data is protected by firestore.rules + Google Auth, not by hiding them.
# ─────────────────────────────────────────────────────────────────────────────

# From Firebase Console → Project settings → Your apps → SDK setup (Config)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: only if you created a NON-default named Firestore database.
# Leave blank to use the default database.
VITE_FIREBASE_DB_ID=

# The Google account allowed to open the host RSVP dashboard (#manage).
# Use the Gmail you will sign in with.
VITE_ADMIN_EMAIL=jhatanishq2298@gmail.com
