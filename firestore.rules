rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. Global default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Global Validation Primitives
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // NOTE: keep this list in sync with ADMIN_EMAILS in src/firebase.ts.
    // These Google accounts may read/manage the RSVP registry.
    function isHostAdmin() {
      return isSignedIn() &&
        request.auth.token.email_verified == true &&
        request.auth.token.email in [
          'jhatanishq2298@gmail.com',
          'muskaanchugh27@gmail.com'
        ];
    }

    // 3. Validation helper for RSVPs (The "Anti-Update-Gap")
    // Keys: fullName, side, attendance, selectedEvents, createdAt (required);
    //       songRequest, additionalGuests (optional). Max 7.
    function isValidRsvp(rsvp) {
      return rsvp.keys().hasAll(['fullName', 'side', 'attendance', 'selectedEvents', 'createdAt'])
        && rsvp.keys().size() <= 7
        && rsvp.fullName is string
        && rsvp.fullName.size() >= 1
        && rsvp.fullName.size() <= 150
        && rsvp.side is string
        && (rsvp.side == 'BRIDE' || rsvp.side == 'GROOM' || rsvp.side == 'BOTH')
        && rsvp.attendance is string
        && (rsvp.attendance == 'YES' || rsvp.attendance == 'NO' || rsvp.attendance == 'VISA')
        && rsvp.selectedEvents is map
        && rsvp.selectedEvents.keys().size() <= 10
        && (!rsvp.keys().hasAny(['songRequest']) || (rsvp.songRequest is string && rsvp.songRequest.size() <= 200))
        && (!rsvp.keys().hasAny(['additionalGuests']) || (rsvp.additionalGuests is list && rsvp.additionalGuests.size() <= 2))
        && rsvp.createdAt == request.time;
    }

    // 4. Secure collection matches
    match /rsvps/{rsvpId} {
      // Only the host admin can read/list responses (guest PII is private)
      allow read, list: if isHostAdmin();

      // Public can create new guest RSVPs, but only in the exact valid shape
      allow create: if isValidId(rsvpId) && isValidRsvp(request.resource.data);

      // RSVPs are immutable to the public; only the host can correct or remove
      allow update: if isHostAdmin() && isValidRsvp(request.resource.data);
      allow delete: if isHostAdmin();
    }
  }
}
